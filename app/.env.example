# MongoDB
MONGO_URI=mongodb://gymbo:gymbo@localhost:27017/gymbo?authSource=admin

# Better Auth (required)
# App data uses MongoDB ObjectId refs. trainers.auth_user_id links to Better Auth user.id.
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5173

# GitHub OAuth (optional — omit to disable GitHub sign-in)
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage (optional local defaults in env.ts)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=qwertyui
STORAGE_BUCKET=gymbo
