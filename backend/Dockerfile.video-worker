# GPU image for RunPod Serverless video queue worker.
# PyTorch + Ultralytics CUDA wheels come from uv.lock; the NVIDIA base image
# aligns the container with the GPU driver.
#
# YOLOv26n checkpoints (`yolo26n.pt`, `yolo26n-pose.pt`, `yolo26n-seg.pt`) are
# fetched at build time from Ultralytics GitHub assets (override release with
# build-arg `ULTRALYTICS_ASSETS_RELEASE`). For air-gapped builds, place those files
# under `src/pose_models/` locally before `docker build` (see .dockerignore).
#
# Build (RunPod / linux amd64):
#   docker build --platform linux/amd64 -f Dockerfile.video-worker -t gymbo-video-worker .
#
# Local GPU smoke test with test_input.json:
#   docker run --rm --gpus all --env-file .env \
#     -v "$(pwd)/test_input.json:/app/test_input.json:ro" \
#     gymbo-video-worker

FROM nvidia/cuda:12.1.0-base-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    PYTHONUNBUFFERED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        libglib2.0-0 \
        libgl1 \
        ffmpeg \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_PYTHON=/usr/bin/python3.12

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src ./src
COPY test_input.json ./test_input.json

# ARG ULTRALYTICS_ASSETS_RELEASE=v8.4.0
# RUN set -eux; \
#     mkdir -p /app/src/pose_models; \
#     cd /app/src/pose_models; \
#     for f in yolo26x.pt yolo26x-pose.pt yolo26x-seg.pt; do \
#       if [ ! -s "$f" ]; then \
#         curl -fsSL -o "$f" \
#           "https://github.com/ultralytics/assets/releases/download/${ULTRALYTICS_ASSETS_RELEASE}/$f"; \
#       fi; \
#     done

ENV PYTHONPATH=/app/src
RUN uv sync --frozen --no-dev

CMD ["uv", "run", "--directory", "/app", "--no-dev", "python", "src/runpod_video_handler.py"]
